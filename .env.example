# ==============================================================================
# ADAPTFIT — Planetary Resilience Engine: Environment Configuration
# ==============================================================================
# 100% Free & Open Access Stack:
# - Geospatial Maps: Leaflet & OpenStreetMap (zero keys, zero billing)
# - Climate Reanalysis: NASA POWER MERRA-2 (public domain, no key needed)
# - Reverse Geocoding: OpenStreetMap Nominatim (open access)
# - Satellite Telemetry: NASA GIBS EPSG:3857 (public open access)
# ==============================================================================

# ─── FRONTEND (Render Static Site: adaptfit-web) ──────────────────────────────
# In local development: leave empty or set to /api (Vite proxies to http://127.0.0.1:5001)
# In production on Render: set to your deployed Flask Web Service URL:
VITE_API_URL=https://adaptfit-api.onrender.com

# ─── BACKEND (Render Web Service: adaptfit-api) ───────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database URL
# Local default:
DATABASE_URL=sqlite:///adaptfit.db
# Render Persistent Disk mount:
# DATABASE_URL=sqlite:////var/data/adaptfit.db
# Render PostgreSQL / Neon / Supabase:
# DATABASE_URL=postgresql://user:password@host/dbname

# CORS Allowed Origins
CORS_ORIGINS=*

# Cache Longevity
HISTORICAL_CACHE_TTL_HOURS=168
FORECAST_CACHE_TTL_HOURS=6
