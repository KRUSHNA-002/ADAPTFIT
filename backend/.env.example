# ==============================================================================
# ADAPTFIT Backend Environment Configuration
# ==============================================================================
# NASA POWER API does NOT require a key — it is free and open access.
# Geospatial maps use Leaflet & OpenStreetMap (zero keys, zero billing).

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///adaptfit.db
# Render Persistent Disk mount example:
# DATABASE_URL=sqlite:////var/data/adaptfit.db
# Render / Cloud PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host/dbname

# CORS Allowed Origins
# Use '*' or comma-separated URLs (e.g. https://adaptfit-web.onrender.com)
CORS_ORIGINS=*

# API Base URLs (Public open-access endpoints, no credentials required)
NASA_POWER_BASE=https://power.larc.nasa.gov/api
OPEN_METEO_HISTORICAL_BASE=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_BASE=https://api.open-meteo.com/v1/forecast

# Cache TTL Settings (Hours)
HISTORICAL_CACHE_TTL_HOURS=168
FORECAST_CACHE_TTL_HOURS=6

